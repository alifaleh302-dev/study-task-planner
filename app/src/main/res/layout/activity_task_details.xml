<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/task_details_title"
            android:textColor="@color/colorPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:textColor="@color/textPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:background="@drawable/bg_priority_badge"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@color/textOnPrimary"
            android:textSize="@dimen/text_small" />

        <TextView
            android:id="@+id/textDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/text_normal" />

        <TextView
            android:id="@+id/textDue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:textColor="@color/textSecondary"
            android:textSize="@dimen/text_normal" />

        <TextView
            android:id="@+id/textCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:textColor="@color/textSecondary"
            android:textSize="@dimen/text_normal" />

        <TextView
            android:id="@+id/textPriority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:textColor="@color/textSecondary"
            android:textSize="@dimen/text_normal" />

        <Button
            android:id="@+id/buttonToggleComplete"
            style="@style/AppButton"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/mark_completed" />

        <Button
            android:id="@+id/buttonEdit"
            style="@style/AppButton"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/edit" />

        <Button
            android:id="@+id/buttonDelete"
            style="@style/AppButton"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/spacing_small"
            android:backgroundTint="@color/priorityHigh"
            android:text="@string/delete" />
    </LinearLayout>
</ScrollView>
